<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error 404 - Social Media</title>
  <!-- Importar Materialize CSS -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <!-- Iconos de Google -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="grey lighten-4">

  <!-- Navbar -->
  <nav>
    <div class="nav-wrapper teal">
      <a href="/" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container center-align" style="margin-top: 80px;">
    <div class="row">
      <div class="col s12">
        <div class="card-panel">
          <i class="material-icons large red-text">error_outline</i>
          <h4 class="red-text">Error 404</h4>
          <h5><%= message || 'Página no encontrada' %></h5>
          <p>Lo que buscas no se encuentra disponible.</p>
          
          <div style="margin-top: 30px;">
            <a href="/posts" class="btn waves-effect waves-light teal">
              <i class="material-icons left">list</i>Ver Posts
            </a>
            <a href="/" class="btn waves-effect waves-light grey">
              <i class="material-icons left">home</i>Inicio
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Importar Materialize JS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>